FROM nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        libsndfile1 \
        python3 \
        python3-dev \
        python-is-python3 \
        python3-pip \
        python3-venv \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace/SepReformer

COPY requirements-l40.txt /tmp/requirements-l40.txt
RUN python3 -m pip install --upgrade pip setuptools wheel \
    && python3 -m pip install \
        torch==2.1.2 torchvision==0.16.2 torchaudio==2.1.2 \
        --index-url https://download.pytorch.org/whl/cu121 \
    && python3 -m pip install -r /tmp/requirements-l40.txt

COPY . .

RUN mkdir -p run_logs \
    models/SepReformer_Base_Libri2Mix_16K/log/scratch_weights \
    models/SepReformer_Base_Libri2Mix_16K/log/pretrain_weights \
    models/SepReformer_PARR_Libri2Mix_16K/log/scratch_weights \
    models/SepReformer_PARR_Libri2Mix_16K/log/pretrain_weights

CMD ["python3", "scripts/preflight_l40.py"]
